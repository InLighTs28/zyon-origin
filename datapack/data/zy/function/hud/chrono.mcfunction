# ZyoN · Chrono HUD (generated by zy_chrono.py) · runs every tick between core/begin and core/end
scoreboard players set #cn zy.tmp 0
scoreboard players operation #cfx zy.tmp = #t zy.t
scoreboard players operation #cfx zy.tmp %= #k8 zy.tmp
execute store success score #cfx zy.tmp if score #cfx zy.tmp matches 4..
scoreboard players set #c_lock zy.tmp 0
scoreboard players set #c_oath zy.tmp 0
scoreboard players set #c_pulse zy.tmp 0
scoreboard players set #c_pcd zy.tmp 0
scoreboard players set #c_charge zy.tmp 0
scoreboard players set #c_event zy.tmp 0
scoreboard players set #c_drift zy.tmp 0
scoreboard players set #c_integ zy.tmp 0
scoreboard players set #c_ess zy.tmp 0

# ready flash when the Pulse recharge ends
execute if score @s zy.hpcd matches 1.. if score @s zy.pulsecd matches ..0 run function zy:hud/chrono_ready
scoreboard players operation @s zy.hpcd = @s zy.pulsecd
scoreboard players remove @s[scores={zy.hrdy=1..}] zy.hrdy 1

execute if score @s zy.view matches 1.. run function zy:hud/chrono/lock
execute if score @s zy.view matches 1.. run function zy:hud/chrono/oath
execute if score @s zy.view matches 1.. run function zy:hud/chrono/pulse
execute if score @s zy.view matches 1.. run function zy:hud/chrono/pcd
execute if score @s zy.view matches 1.. run function zy:hud/chrono/charge
execute if score @s zy.view matches 1.. run function zy:hud/chrono/event
execute if score @s zy.view matches 1.. run function zy:hud/chrono/drift
execute if score @s zy.view matches 1.. run function zy:hud/chrono/integ
execute if score @s zy.view matches 1.. run function zy:hud/chrono/ess

apoli:resource operation @s zy:hud/chrono_lock = #c_lock zy.tmp
apoli:resource operation @s zy:hud/chrono_oath = #c_oath zy.tmp
apoli:resource operation @s zy:hud/chrono_pulse = #c_pulse zy.tmp
apoli:resource operation @s zy:hud/chrono_pcd = #c_pcd zy.tmp
apoli:resource operation @s zy:hud/chrono_charge = #c_charge zy.tmp
apoli:resource operation @s zy:hud/chrono_event = #c_event zy.tmp
apoli:resource operation @s zy:hud/chrono_drift = #c_drift zy.tmp
apoli:resource operation @s zy:hud/chrono_integ = #c_integ zy.tmp
apoli:resource operation @s zy:hud/chrono_ess = #c_ess zy.tmp
apoli:resource operation @s zy:hud/chrono_tn = #cn zy.tmp
apoli:resource operation @s zy:hud/chrono_fx = #cfx zy.tmp
