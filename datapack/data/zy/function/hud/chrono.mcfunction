# ZyoN · reticle timers (generated by zy_chrono2.py) · every tick, between core/begin and core/end
execute if score @s zy.hpcd matches 1.. if score @s zy.pulsecd matches ..0 run function zy:hud/chrono_ready
scoreboard players operation @s zy.hpcd = @s zy.pulsecd
scoreboard players remove @s[scores={zy.hrdy=1..}] zy.hrdy 1
scoreboard players set #q_ring zy.tmp 0
scoreboard players set #q_tl zy.tmp 0
scoreboard players set #q_tr zy.tmp 0
scoreboard players set #q_bl zy.tmp 0
scoreboard players set #q_br zy.tmp 0
execute if score @s zy.view matches 1.. run function zy:hud/chrono/all
scoreboard players operation #cfx zy.tmp = #t zy.t
scoreboard players operation #cfx zy.tmp %= #k8 zy.tmp
execute store success score #cfx zy.tmp if score #cfx zy.tmp matches 4..
execute unless score @s zy.qring = #q_ring zy.tmp run function zy:hud/chrono/push_ring
execute unless score @s zy.qtl = #q_tl zy.tmp run function zy:hud/chrono/push_tl
execute unless score @s zy.qtr = #q_tr zy.tmp run function zy:hud/chrono/push_tr
execute unless score @s zy.qbl = #q_bl zy.tmp run function zy:hud/chrono/push_bl
execute unless score @s zy.qbr = #q_br zy.tmp run function zy:hud/chrono/push_br
execute unless score @s zy.qfx = #cfx zy.tmp run function zy:hud/chrono/push_fx
