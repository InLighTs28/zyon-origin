{
  "type": "apoli:action_on_scroll_wheel",
  "direction": "up",
  "scroll_amount": 1,
  "prevent_hotbar_change": true,
  "cooldown": 2,
  "condition": {
    "type": "apoli:and",
    "conditions": [
      {
        "type": "apoli:key_pressed",
        "key": {
          "key": "key.origins.ternary_active"
        }
      },
      {
        "type": "apoli:sneaking"
      }
    ]
  },
  "hud_render": {
    "should_render": false
  },
  "entity_action": {
    "type": "apoli:execute_command",
    "command": "function zy:rcon/inc"
  },
  "hidden": true
}
