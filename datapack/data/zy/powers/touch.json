{
  "type": "apoli:action_on_entity_use",
  "condition": {
    "type": "apoli:scoreboard",
    "objective": "zy.charge",
    "comparison": ">=",
    "compare_to": 1
  },
  "hands": [
    "main_hand"
  ],
  "action_result": "success",
  "bientity_action": {
    "type": "apoli:and",
