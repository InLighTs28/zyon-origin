            {
              "type": "apoli:target_condition",
              "condition": {
                "type": "apoli:scoreboard",
                "objective": "zy.mom",
                "comparison": ">=",
                "compare_to": 1
              }
            },
            {
              "type": "apoli:actor_condition",
              "condition": {
                "type": "apoli:scoreboard",
                "objective": "zy.tier",
                "comparison": ">=",
                "compare_to": 4
              }
            },
            {
              "type": "apoli:actor_condition",
              "condition": {
                "type": "apoli:scoreboard",
                "objective": "zy.cmode",
                "comparison": "==",
                "compare_to": 2
              }
            }
          ]
        },
        "if_action": {
          "type": "apoli:add_velocity",
          "reference": "rotation",
          "x": 0,
          "y": 0.6,
          "z": 2.2
        }
      },
      {
        "type": "apoli:target_action",
        "action": {
          "type": "apoli:execute_command",
          "command": "tag @s add zy.tgt"
        }
      },
      {
