        },
        {
          "type": "apoli:execute_command",
          "command": "tag @e[tag=zy.fxp4] remove zy.fxp4"
        },
        {
          "type": "apoli:execute_command",
          "command": "tag @e[tag=zy.fxp5] remove zy.fxp5"
        },
        {
          "type": "apoli:execute_command",
          "command": "tag @e[tag=zy.fxp6] remove zy.fxp6"
        },
        {
          "type": "apoli:execute_command",
          "command": "tag @e[tag=zy.fxp7] remove zy.fxp7"
        },
        {
          "type": "apoli:execute_command",
          "command": "tag @e[tag=zy.fxp8] remove zy.fxp8"
        }
      ]
    }
  },
  "ui": {
    "type": "apoli:resource",
    "min": 0,
    "max": 999,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
