{
  "type": "apoli:active_self",
  "name": "Apposer un sceau",
  "description": "Touche primaire : appose le sceau choisi sur l'être vivant visé, ou sur toi si tu ne vises rien. Les êtres qui portent le même sceau forment un réseau : ce qui touche l'un touche les autres.",
  "key": {
    "key": "key.origins.primary_active",
    "continuous": false
  },
  "cooldown": 10,
  "hud_render": {
    "should_render": false
  },
  "condition": {
    "type": "apoli:sneaking",
    "inverted": true
  },
  "entity_action": {
    "type": "apoli:and",
    "actions": [
      {
        "type": "apoli:raycast",
        "distance": 24,
        "block": true,
        "entity": true,
        "bientity_action": {
          "type": "apoli:and",
          "actions": [
            {
              "type": "apoli:target_action",
              "action": {
                "type": "apoli:execute_command",
                "command": "tag @s add zy.tgt"
              }
            }
          ]
        }
      },
      {
        "type": "apoli:execute_command",
        "command": "function zy:sceau/apposer"
      }
    ]
  }
}
