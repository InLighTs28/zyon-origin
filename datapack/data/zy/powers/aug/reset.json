{
  "type": "apoli:action_over_time",
  "hidden": true,
  "interval": 5,
  "entity_action": {
    "type": "apoli:if_else",
    "condition": {
      "type": "apoli:scoreboard",
      "objective": "zy.spreset",
      "comparison": ">=",
      "compare_to": 1
    },
    "if_action": {
      "type": "apoli:and",
      "actions": [
        {
          "type": "apoli:reset_skills",
          "tree": "zy:zyon",
          "refund": false
        },
        {
          "type": "apoli:add_skill_points",
          "skill_tree": "zy:zyon",
          "points": -100000
        },
        {
          "type": "apoli:execute_command",
          "command": "scoreboard players set @s zy.spreset 0"
        }
      ]
    }
  }
}
