{
  "type": "apoli:action_on_scroll_wheel",
  "direction": "down",
  "scroll_amount": 1,
  "prevent_hotbar_change": true,
  "cooldown": 2,
  "condition": {
    "type": "apoli:and",
    "conditions": [
      {
        "type": "apoli:or",
        "conditions": [
          {
            "type": "apoli:sneaking"
          },
          {
            "type": "apoli:key_pressed",
            "key": {
              "key": "key.origins.secondary_active"
            }
          }
        ]
      },
      {
        "type": "apoli:key_pressed",
        "key": {
          "key": "key.origins.ternary_active"
        },
        "inverted": true
      }
    ]
  },
  "hud_render": {
    "should_render": false
  },
  "entity_action": {
    "type": "apoli:execute_command",
    "command": "function zy:core/cycle_next"
  },
  "hidden": true
}
